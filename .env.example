# Select a provider. Gemini is the default. Change this and redeploy to switch later.
IMAGE_PROVIDER=gemini
# Server-side Google AI Studio key. Never prefix with NEXT_PUBLIC_ or commit real keys.
GEMINI_API_KEY=
# Must support image output and uploaded-image editing.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Separate vision/text model for photo-grounded materials and detailed steps.
# Uses GEMINI_API_KEY even when IMAGE_PROVIDER=openai.
GEMINI_PLANNING_MODEL=gemini-2.5-flash
# Optional alternative: only used with IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Future PostgreSQL persistence (not connected yet).
DATABASE_URL=
# Supabase accounts and private cloud project storage (apply supabase/setup.sql first).
NEXT_PUBLIC_SUPABASE_URL=
# Public/publishable key, NOT a service_role or secret key. Legacy ANON_KEY also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
