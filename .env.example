# Select a provider. Gemini is the default. Change this and redeploy to switch later.
IMAGE_PROVIDER=gemini
# Server-side Google AI Studio key. Never prefix with NEXT_PUBLIC_ or commit real keys.
GEMINI_API_KEY=
# Must support image output and uploaded-image editing.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Separate vision/text model for photo-grounded materials and detailed steps.
# Uses GEMINI_API_KEY even when IMAGE_PROVIDER=openai.
# Leave unset to allow discovery if the default model is unavailable.
# Set explicitly only to pin a supported text/vision model.
# GEMINI_PLANNING_MODEL=gemini-2.5-flash
# Optional alternative: only used with IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Future PostgreSQL persistence (not connected yet).
DATABASE_URL=
# Supabase accounts and private cloud project storage (apply supabase/setup.sql first).
NEXT_PUBLIC_SUPABASE_URL=
# Public/publishable key, NOT a service_role or secret key. Legacy ANON_KEY also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App Store consumable purchase: one project + three design revisions.
# Apply supabase/billing.sql, configure RevenueCat webhooks, then enable.
BILLING_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PROJECT_PRODUCT_ID=buildly.project.single
NEXT_PUBLIC_PROJECT_PRODUCT_ID=buildly.project.single
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# Enable for TestFlight's sandbox transactions. Set false for a production-only backend.
BILLING_ALLOW_SANDBOX=false
# Native app origin; use the stable production domain, never an immutable preview URL.
BUILDLY_APP_URL=https://buildly-ecru.vercel.app

# Non-payment service hardening: apply supabase/production.sql before deployment.
# SUPABASE_SERVICE_ROLE_KEY above is needed for durable private jobs/deletion even
# when purchase functionality is not enabled. Never expose it to a client.
BUILDLY_GENERATION_ENABLED=true
BUILDLY_DAILY_REQUESTS=20
BUILDLY_GLOBAL_DAILY_REQUESTS=50
# Generate securely in the production host; match the protected Actions secret.
BUILDLY_MAINTENANCE_TOKEN=
# Hosting cron sends this value automatically; use the same server-only value
# as BUILDLY_MAINTENANCE_TOKEN. Do not enable both hosting and Actions schedules.
CRON_SECRET=
